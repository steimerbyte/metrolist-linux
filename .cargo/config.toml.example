# Copy to .cargo/config.toml for a single-core local build.
#
# No rustc-wrapper is committed: a wrapper needs an absolute path, so it is
# host-specific. The maintainer's host config adds
#   rustc-wrapper = "/absolute/path/to/metrolist-linux/scripts/rustc-single.sh"
# which flocks every rustc invocation project-wide.
[build]
jobs = 1
