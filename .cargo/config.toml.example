# Copy to .cargo/config.toml for a local build.
#
# Max 2 rustc processes project-wide. Set jobs = 2 and, for concurrency across
# separate target dirs, add the 2-slot semaphore wrapper as an ABSOLUTE path
# (cargo requires absolute; a relative one breaks other checkouts):
#
#   rustc-wrapper = "/absolute/path/to/metrolist-linux/scripts/rustc-single.sh"
#
# Never raise CARGO_BUILD_JOBS above 2.
[build]
jobs = 2
